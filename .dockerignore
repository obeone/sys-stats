# Ignore hidden files and directories
.*
!.dockerignore

# Ignore history folders
.history/
.history/**

# Ignore temporary or backup files
*~
*.swp
*.bak
*.tmp
*.old

# Ignore log files
*.log

# Ignore development-only trees, never copied into the image
tests/
docs/

# Ignore the following directories
templates/templates/
chart/
.compose/

# Exclude compiled Python files and local dependency/config files
__pycache__/
*.py[cod]
.env
*.env
.vscode/
.idea/
